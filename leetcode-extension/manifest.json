{
  "manifest_version": 3,
  "name": "LeetGit",
  "version": "1.0.0",
  "key": "",
  "description": "Sync LeetCode problems with my backend",

  "icons": {
    "16": "assets/leetgit-logo.png",
    "32": "assets/leetgit-logo.png",
    "48": "assets/leetgit-logo.png",
    "128": "assets/leetgit-logo.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://leetgit-dashboard-v1-production.up.railway.app/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.com/progress/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "LeetGit"
  },

  "side_panel": {
    "default_path": "popup.html"
  }
}